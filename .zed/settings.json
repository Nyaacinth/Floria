{
    "tab_size": 4,
    "format_on_save": "on",
    "prettier": { "allowed": false },
    "formatter": [{ "language_server": { "name": "oxfmt" } }],
    "languages": {
        "TypeScript": {
            "language_servers": ["typescript-ls", "oxlint", "!vtsls", "!typescript-language-server", "..."]
        },
        "TSX": {
            "language_servers": ["typescript-ls", "oxlint", "!vtsls", "!typescript-language-server", "..."]
        }
    }
}
