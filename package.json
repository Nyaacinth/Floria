{
    "name": "work.nyaacinth.floria",
    "private": true,
    "description": "Floria App",
    "version": "1.0.0",
    "type": "module",
    "main": "packages/entry-point.js",
    "packageManager": "bun@1.3.12",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "bun run --workspaces --if-present build",
        "compile": "bun run build && electron-builder build --config electron-builder.js",
        "start": "bun run packages/dev-mode.js",
        "lint": "bun run --workspaces --if-present lint"
    },
    "devDependencies": {
        "@npmcli/map-workspaces": "5.0.3",
        "@playwright/test": "1.59.1",
        "@prettier/plugin-oxc": "^0.1.4",
        "@types/node": "25.6.0",
        "electron": "42.0.0",
        "electron-builder": "26.8.1",
        "glob": "13.0.6",
        "playwright": "1.59.1",
        "prettier": "3.8.3"
    },
    "dependencies": {
        "@app/main": "workspace:*"
    }
}
