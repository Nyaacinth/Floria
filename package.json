{
    "name": "work.nyaacinth.floria",
    "version": "1.0.0",
    "private": true,
    "description": "Floria App",
    "type": "module",
    "main": "packages/entry-point.js",
    "scripts": {
        "build": "pnpm -r run build",
        "compile": "pnpm run build && pnpm electron-builder build --config electron-builder.config.js",
        "format": "oxfmt .",
        "lint": "pnpm -r run lint",
        "start": "node packages/dev-mode.js"
    },
    "dependencies": {
        "@app/main": "workspace:*"
    },
    "devDependencies": {
        "@npmcli/map-workspaces": "6.0.0",
        "@types/node": "26.4.1",
        "confbox": "0.3.0",
        "electron": "44.1.1",
        "electron-builder": "26.15.3",
        "glob": "13.0.6",
        "oxfmt": "0.66.0",
        "oxlint": "1.81.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "7.0.2"
    }
}
