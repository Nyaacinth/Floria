{
    "name": "work.nyaacinth.floria",
    "version": "1.0.0",
    "private": true,
    "description": "Floria App",
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "main": "packages/entry-point.js",
    "scripts": {
        "build": "pnpm -r run build",
        "compile": "pnpm run build && pnpm electron-builder build --config electron-builder.js",
        "lint": "pnpm -r run lint",
        "start": "node packages/dev-mode.js"
    },
    "dependencies": {
        "@app/main": "workspace:*"
    },
    "devDependencies": {
        "@npmcli/map-workspaces": "6.0.0",
        "@types/node": "26.1.2",
        "electron": "43.2.0",
        "electron-builder": "26.15.3",
        "glob": "13.0.6",
        "oxfmt": "0.61.0"
    }
}
