{
    "name": "work.nyaacinth.floria",
    "private": true,
    "description": "Floria App",
    "version": "1.0.0",
    "type": "module",
    "main": "packages/entry-point.js",
    "packageManager": "pnpm@11.8.0",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
