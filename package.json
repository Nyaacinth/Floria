{
    "name": "work.nyaacinth.floria",
    "version": "1.0.0",
    "private": true,
    "description": "Floria App",
    "type": "module",
    "main": "packages/entry-point.js",
    "scripts": {
        "build": "pnpm -r run build",
        "compile": "pnpm run build && pnpm electron-builder build --config electron-builder.config.js",
        "format": "oxfmt .",
        "lint": "pnpm -r run lint",
        "start": "node packages/dev-mode.js"
    },
    "dependencies": {
        "@app/main": "workspace:*"
    },
    "devDependencies": {
        "@npmcli/map-workspaces": "6.0.0",
        "@types/node": "26.6.5",
        "confbox": "0.3.1",
        "electron": "45.0.0",
        "electron-builder": "26.18.0",
        "glob": "13.0.6",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "typescript": "7.0.2"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0"
        }
    }
}
